{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "version-file": "VERSION",
      "changelog-path": "CHANGELOG.md",
      "initial-version": "1.0.0",
      "include-component-in-tag": false,
      "changelog-sections": [
        {
          "type": "feat",
          "section": "Features",
          "hidden": false
        },
        {
          "type": "fix",
          "section": "Fixes",
          "hidden": false
        },
        {
          "type": "docs",
          "section": "Documentation",
          "hidden": false
        },
        {
          "type": "refactor",
          "section": "Refactoring",
          "hidden": false
        },
        {
          "type": "perf",
          "section": "Performance",
          "hidden": false
        },
        {
          "type": "test",
          "section": "Tests",
          "hidden": false
        },
        {
          "type": "build",
          "section": "Build",
          "hidden": false
        },
        {
          "type": "ci",
          "section": "CI",
          "hidden": false
        },
        {
          "type": "chore",
          "section": "Maintenance",
          "hidden": false
        },
        {
          "type": "revert",
          "section": "Reverts",
          "hidden": false
        }
      ],
      "extra-files": [
        {
          "type": "generic",
          "path": "templates/AGENTS.md"
        },
        {
          "type": "generic",
          "path": "docs/adoption.md"
        },
        {
          "type": "generic",
          "path": "docs/versioning.md"
        }
      ]
    }
  }
}
